-- Brew Full Update launcher. GENERATED INTO THE APP by build-app.sh from
-- brew_full_update.zsh; edit the .zsh file, not the embedded copy.
-- Choosing "Dry Run" in the dialog previews the update without changing anything.
-- Choosing "Exclusions" adds a cask to leave out of upgrades; the script reads the saved list on every run.
set appIcon to path to resource "applet.icns"
set exclusionsDir to (POSIX path of (path to home folder)) & "Library/Application Support/Brew Full Update"
set exclusionsFile to exclusionsDir & "/exclusions.txt"
set modeFlag to ""
repeat
	set dialogResult to display dialog (my mainText(exclusionsFile)) with title "Brew Command Center" with icon appIcon buttons {"Exclusions", "Dry Run", "Update"} default button "Update" giving up after 15
	if (gave up of dialogResult) is false and (button returned of dialogResult) is "Exclusions" then
		my addExclusion(exclusionsDir, exclusionsFile)
	else
		if (gave up of dialogResult) is false and (button returned of dialogResult) is "Dry Run" then set modeFlag to "--dry-run"
		exit repeat
	end if
end repeat

set shellCode to "@@SHELL_CODE@@"

-- Run as a .command file so Terminal starts a non-interactive zsh: ~/.zshrc (which sources files in Documents) is never read.
set tempDir to do shell script "umask 077; /usr/bin/mktemp -d /tmp/brew-full-update.XXXXXX"
set commandFile to tempDir & "/Brew Full Update.command"
try
	set fullCode to "#!/bin/zsh" & linefeed & shellCode & linefeed & "brew_full_update " & modeFlag & linefeed & "update_result=$?" & linefeed & "/bin/rm -rf " & quoted form of tempDir & linefeed & "exit $update_result" & linefeed
	do shell script "/usr/bin/printf '%s' " & quoted form of fullCode & " > " & quoted form of commandFile & " && /bin/chmod 700 " & quoted form of commandFile
	do shell script "/usr/bin/open -a Terminal " & quoted form of commandFile
on error errorMessage number errorNumber
	do shell script "/bin/rm -rf " & quoted form of tempDir
	error errorMessage number errorNumber
end try

-- Main dialog text; lists the user's own exclusions so the text follows the saved list.
on mainText(exclusionsFile)
	set txt to "Update everything now, or preview first?" & return & return & "Dry Run lists what would change and installs nothing. If you do nothing, Update starts in 15 seconds."
	set savedNames to my readExclusions(exclusionsFile)
	if (count of savedNames) > 0 then set txt to txt & return & return & "Also excluded: " & my joinList(savedNames, ", ")
	return txt
end mainText

-- Asks for one cask name and appends it to the saved list. Cancel or an invalid name changes nothing.
on addExclusion(exclusionsDir, exclusionsFile)
	set savedNames to my readExclusions(exclusionsFile)
	set shownNames to "none yet"
	if (count of savedNames) > 0 then set shownNames to my joinList(savedNames, ", ")
	try
		set answer to display dialog "Cask name to leave out of upgrades. Any cask whose name starts with it is skipped." & return & return & "Examples: topaz-photo, firefox" & return & return & "Your exclusions: " & shownNames with title "Brew Command Center" default answer "" buttons {"Cancel", "Add"} default button "Add" cancel button "Cancel"
	on error number -128
		return
	end try
	set cask to do shell script "printf %s " & quoted form of (text returned of answer) & " | /usr/bin/tr -d '[:space:]' | /usr/bin/tr '[:upper:]' '[:lower:]'"
	if cask is "" then return
	set validCount to do shell script "printf %s " & quoted form of cask & " | /usr/bin/grep -E -c '^[a-z0-9][a-z0-9@._+-]*$' || true"
	if validCount is not "1" then
		display dialog "Cask names use lowercase letters, numbers and hyphens, for example topaz-photo." with title "Brew Command Center" buttons {"OK"} default button "OK"
		return
	end if
	if cask is in savedNames then return
	do shell script "/bin/mkdir -p " & quoted form of exclusionsDir & " && /usr/bin/printf '%s\\n' " & quoted form of cask & " >> " & quoted form of exclusionsFile
end addExclusion

-- Names saved in the exclusions file, one per line; empty when the file doesn't exist yet.
on readExclusions(exclusionsFile)
	set raw to do shell script "/bin/cat " & quoted form of exclusionsFile & " 2>/dev/null; true"
	set savedNames to {}
	repeat with ln in paragraphs of raw
		if (ln as text) is not "" then set end of savedNames to (ln as text)
	end repeat
	return savedNames
end readExclusions

on joinList(theList, delim)
	set AppleScript's text item delimiters to delim
	set theText to theList as text
	set AppleScript's text item delimiters to ""
	return theText
end joinList
